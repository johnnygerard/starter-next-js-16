{
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "warn",
      "version": "11"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "24"
    }
  },
  "name": "starter-next-js-16",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "tsc --noEmit",
    "deploy:preview": "vercel pull --environment=preview && vercel build && vercel deploy --prebuilt",
    "deploy:production": "vercel pull --environment=production && vercel build --prod && vercel deploy --prebuilt --prod",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "serve out -l 4000"
  },
  "type": "module",
  "version": "0.0.0"
}
